bucket       = "REPLACE-ME-tfstate-bucket"   # output of bootstrap/digitalocean
key          = "argocd-terraform/digitalocean/dev/terraform.tfstate"
endpoints    = { s3 = "https://ams3.digitaloceanspaces.com" }
region       = "us-east-1"   # required by the S3 backend, ignored by Spaces
use_lockfile = true

skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_s3_checksum            = true
